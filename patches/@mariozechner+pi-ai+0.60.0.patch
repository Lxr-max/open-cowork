+ * Anthropic-style `{ type: "thinking" }` fails on DeepSeek's OpenAI-compatible
+ * endpoint (`https://api.deepseek.com`) with:
+ *   unknown variant `thinking`, expected `text`
+ * Strip those parts from outbound history. Stored SDK/DB messages are unchanged.
+ */
+function stripThinkingBlocksFromOpenAICompatibleMessages(messages) {
+    return messages.map((msg) => {
+        if (!msg || !Array.isArray(msg.content)) {
+            return msg;
+        }
+        const content = msg.content.filter((part) => !part || part.type !== "thinking");
+        if (content.length === msg.content.length) {
+            return msg;
+        }
+        return { ...msg, content };
+    });
